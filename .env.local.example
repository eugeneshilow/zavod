ADMIN_PASSWORD=
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
# Публикация: две двери одной очереди — Instagram и Telegram (канон — docs/publish.md).
# ADMIN_API_TOKEN — один и тот же в Convex и в Vercel: им /admin и
# /api/reels/health спрашивают у Convex очередь и эфир.
ADMIN_API_TOKEN=
# Только в Convex env: расписание кронов и общий рубильник публикации
# (имя историческое — он глушит обе двери, не только Instagram).
INSTAGRAM_CRONS_ENABLED=
INSTAGRAM_POSTING_ENABLED=
# Только в Convex env: секрет приложения Meta. Им машина меняет одноразовый код
# входа на токен аккаунта (docs/publish.md, «Как аккаунт получает токен»).
# Id приложения секретом не является и передаётся аргументом команды.
INSTAGRAM_APP_SECRET=
# Только в Convex env: ключи двери Telegram. TELEGRAM_BOT_TOKEN выдаёт @BotFather
# и он не протухает; TELEGRAM_CHAT_ID — канал, например @autovibecoding.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Голос рельсы «История» (канон — docs/reels.md): Яндекс SpeechKit. Либо эти
# две переменные, либо живая консоль yc — тогда рендер сам возьмёт токен
# командой `yc iam create-token`, а папку — `yc config get folder-id`.
YC_API_KEY=
YC_FOLDER_ID=
