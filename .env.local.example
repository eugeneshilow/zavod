# Convex CLI заполнит .env.local после запуска npx convex dev и входа владельца.
# Значения здесь пустые. Файл .env.local никогда не коммитится.

# Выбранный deployment Convex.
CONVEX_DEPLOYMENT=

# Адрес базы для клиентского провайдера; пустое значение отключает подключение.
NEXT_PUBLIC_CONVEX_URL=

# Адрес HTTP actions, который также записывает Convex CLI для Next.js.
NEXT_PUBLIC_CONVEX_SITE_URL=
